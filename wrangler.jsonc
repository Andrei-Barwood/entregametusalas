{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "entregametusalas",
  "main": "worker.js",
  "compatibility_date": "2026-06-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "kv_namespaces": [
    {
      "binding": "FEED_KV",
      "id": "FEED_KV_ID_PLACEHOLDER"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
