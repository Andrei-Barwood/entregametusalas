<!-- SCRIPT DE CONTROL DE LUMINOSIDAD SCROLL-DRIVEN & AUTO-SCROLL DE CRÉDITOS -->
<script>
  (function() {
    const track = document.getElementById('credits-scroll-track');
    const cards = document.querySelectorAll('.credit-card');
    const lumReadout = document.getElementById('credits-lum-readout');
    const btnAuto = document.getElementById('btn-toggle-autoscroll');
    const btnSpeed = document.getElementById('btn-speed-crawl');
    const btnRewind = document.getElementById('btn-rewind-credits');

    // 1. Observer de Luminosidad Scroll-Driven
    // Cada referencia bibliográfica es ligeramente más oscura que la anterior.
    // Para observar la iluminación completa al 100%, el usuario debe scrollear hacia abajo.
    if ('IntersectionObserver' in window) {
      const lumObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('fully-illuminated');
            if (lumReadout) {
              const idx = entry.target.getAttribute('data-index') || 'FINAL';
              lumReadout.textContent = `100% [REF ${idx}]`;
              lumReadout.style.textShadow = '0 0 12px hsl(150, 100%, 75%)';
            }
          } else {
            // Fuera de la vista activa vuelve a su gradiente tenue
            entry.target.classList.remove('fully-illuminated');
          }
        });
      }, {
        threshold: 0.25,
        rootMargin: '-5% 0px -15% 0px'
      });

      cards.forEach(card => lumObserver.observe(card));
    }

    // 2. Sistema de Auto-Scroll Cinemático estilo Fin de Videojuego
    let autoScrollInterval = null;
    let scrollSpeed = 1.0; // px por tick
    let speedTier = 1;

    function startAutoScroll() {
      if (autoScrollInterval) return;
      btnAuto.textContent = '⏸ PAUSAR CRÉDITOS';
      btnAuto.classList.add('active-crawl');
      autoScrollInterval = setInterval(() => {
        window.scrollBy({ top: scrollSpeed, behavior: 'auto' });
        // Si llega al final, detenerse suavemente
        if ((window.innerHeight + window.scrollY) >= (document.body.offsetHeight - 10)) {
          stopAutoScroll();
        }
      }, 25);
    }

    function stopAutoScroll() {
      if (autoScrollInterval) {
        clearInterval(autoScrollInterval);
        autoScrollInterval = null;
      }
      btnAuto.textContent = '▶ AUTO-SCROLL CRÉDITOS';
      btnAuto.classList.remove('active-crawl');
    }

    if (btnAuto) {
      btnAuto.addEventListener('click', () => {
        if (autoScrollInterval) {
          stopAutoScroll();
        } else {
          startAutoScroll();
        }
      });
    }

    if (btnSpeed) {
      btnSpeed.addEventListener('click', () => {
        speedTier = (speedTier % 3) + 1;
        scrollSpeed = speedTier === 1 ? 1.0 : (speedTier === 2 ? 2.5 : 5.0);
        btnSpeed.textContent = `VELOCIDAD: ${speedTier}X`;
      });
    }

    if (btnRewind) {
      btnRewind.addEventListener('click', () => {
        stopAutoScroll();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Al interactuar con scroll de rueda o teclado manual, pausar el autoscroll para no interferir
    window.addEventListener('wheel', () => {
      if (autoScrollInterval) stopAutoScroll();
    }, { passive: true });
    window.addEventListener('touchmove', () => {
      if (autoScrollInterval) stopAutoScroll();
    }, { passive: true });
  })();
</script>
