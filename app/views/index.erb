                <label for="feed-author-input" class="feed-label">TU ALIAS O CADETE ID:</label>
                <input
                  type="text"
                  id="feed-author-input"
                  name="author"
                  class="soc-input"
                  placeholder="Cadete_NetAcad..."
                  maxlength="50"
                  required
                >
              </div>
              <div style="flex: 1; min-width: 170px;">
                <label for="feed-post-episode-select" class="feed-label">EPISODIO ASOCIADO:</label>
                <select id="feed-post-episode-select" name="episode_id" class="soc-select">
                  <option value="">CANAL GENERAL</option>
                  <% @episodes.each do |ep| %>
                    <option value="<%= ep['id'] %>" <%= ep['id'] == ep0['id'] ? 'selected' : '' %>>
                      <%= ep['code'] %>: <%= ep['game_node_code'] %>
                    </option>
                  <% end %>
                </select>
              </div>
            </div>

            <div>
              <label for="feed-post-content" class="feed-label">
                OBSERVACIÓN CLÍNICA / COMANDO KALI / PARCHE (MÁX. 2000 CARACTERES):
              </label>
              <textarea
                id="feed-post-content"
                name="content"
                class="soc-input feed-textarea"
                rows="4"
                maxlength="2000"
                placeholder="Comparte con tus compañeros del pod hallazgos de CVE, reglas iptables, comandos nmap o configuraciones eléctricas del episodio..."
                required
              ></textarea>
            </div>

            <div id="feed-form-alert" class="feed-alert-box" style="display: none;"></div>

            <div class="feed-compose-footer">
              <div id="feed-char-counter" class="feed-char-counter">
                0 / 2000 caracteres
              </div>
              <button type="submit" id="btn-feed-submit" class="soc-btn soc-btn-warning" style="font-weight: 700; padding: 0.35rem 0.9rem; font-size: 0.76rem;">
                PUBLICAR EN EL MURO
              </button>
            </div>
          </form>

          <!-- NOTA EXPLICATIVA SOBRE EL ALMACENAMIENTO LIGERO -->
          <div style="margin-top: 0.85rem; padding: 0.6rem; background: rgba(14,17,17,0.7); border: 1px dashed var(--border-structural); font-size: 0.69rem; color: var(--hud-glass-outline); line-height: 1.4;">
            <div style="color: var(--iris-warning-high); font-weight: 700; margin-bottom: 0.2rem;">
              💡 ARQUITECTURA ULTRACOMPACTA SIN FIREBASE:
            </div>
            Cada mensaje se apenda atómicamente a un documento de texto compacto (<code style="color: var(--magic-ring);">data/clinical_wall_feed.jsonl</code>). Con ~200 bytes por mensaje, 3 Megabytes proporcionan hasta 5 años de historial infinito sin requerir servidores externos ni costes en la nube.
          </div>
        </div>

        <!-- COLUMNA DERECHA: STREAM DEL MURO SOCIAL Y FILTROS -->
        <div class="feed-stream-column">
          <div class="feed-stream-toolbar">
            <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
              <span style="font-size: 0.72rem; font-weight: 700; color: #FFFFFF;">FILTRAR:</span>
              <select id="feed-filter-select" class="soc-select" style="max-width: 220px; font-size: 0.7rem; padding: 0.2rem 0.4rem;">
                <option value="all">TODOS LOS EPISODIOS</option>
                <% @episodes.each do |ep| %>
                  <option value="<%= ep['id'] %>"><%= ep['code'] %>: <%= ep['game_node_code'] %></option>
                <% end %>
              </select>
            </div>
            <div class="feed-filter-pills">
              <button type="button" class="soc-btn feed-filter-btn active" data-ep="all" style="font-size: 0.65rem; padding: 0.15rem 0.4rem;">TODOS</button>
              <button type="button" class="soc-btn feed-filter-btn" data-ep="1" style="font-size: 0.65rem; padding: 0.15rem 0.4rem;">EP01</button>
              <button type="button" class="soc-btn feed-filter-btn" data-ep="4" style="font-size: 0.65rem; padding: 0.15rem 0.4rem;">EP04</button>
              <button type="button" class="soc-btn feed-filter-btn" data-ep="12" style="font-size: 0.65rem; padding: 0.15rem 0.4rem;">EP12</button>
              <button type="button" class="soc-btn feed-filter-btn" data-ep="22" style="font-size: 0.65rem; padding: 0.15rem 0.4rem;">EP22</button>
            </div>
          </div>

          <!-- CONTENEDOR CON SCROLL DEL STREAM DE MENSAJES -->
          <div id="feed-stream-container" class="feed-stream-list" style="max-height: 480px; overflow-y: auto;">
            <!-- Renderizado dinámico vía JavaScript y auto-polling cada 5 segundos -->
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
