<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CYBERIA-MED // SOC Console v19.96 — BLADES Neural &amp; IoMT Telemetry</title>

  <!-- METADATOS OPEN GRAPH Y TWITTER (PREVISUALIZACIÓN EN WHATSAPP Y REDES SOCIALES) -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="CYBERIA-MED // SOC Console &amp; Muro Clínico Pod NetAcad">
  <meta property="og:description" content="Instalación biotecnológica submarina Snocomm Lounge y consola de telemetría médica en tiempo real para 48 episodios clínicos y ciberseguridad hospitalaria.">
  <meta property="og:image" content="https://entregametusalas.pages.dev/img/underwater_lounge_habitat.jpg">
  <meta property="og:image:secure_url" content="https://entregametusalas.pages.dev/img/underwater_lounge_habitat.jpg">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1440">
  <meta property="og:image:height" content="1080">
  <meta property="og:image:alt" content="Cyberia Deep Habitat Lounge — Sala de Descanso y Meditación Submarina">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https://entregametusalas.pages.dev/img/underwater_lounge_habitat.jpg">
  <link rel="stylesheet" href="/css/chrysalis_medsoc.css">
</head>
<body>
  <div class="blades-crt-overlay" aria-hidden="true"></div>

  <!-- CABECERA GLOBAL DEL MEDICAL SOC -->
  <header class="medsoc-topbar">
    <div class="brand-block">
      <div class="blades-emblem" title="BLADES Biocybernetic Sensor v19.96">B</div>
      <div>
        <div class="brand-title">CYBERIA-MED // SOC CONSOLE v19.96</div>
        <div class="brand-subtitle">
          SUBJECT: ZAK // IMPLANT: BLADES (IR / MRI / BIOMETRIC DPI) // PALETTE: QUEEN CHRYSALIS #523
        </div>
      </div>
    </div>

    <nav class="top-nav-links" aria-label="Navegación Principal del SOC">
      <a href="/tutorial" id="btn-nav-tutorial" class="soc-btn <%= request.path_info == '/tutorial' || request.path_info == '/landing' ? 'active' : '' %>" style="border-color: var(--iris-warning-high); color: var(--iris-warning-high);">
        [00] GUÍA CLÍNICA &amp; TUTORIAL KALI (EP01)
      </a>
      <a href="/" class="soc-btn <%= request.path_info == '/' ? 'active' : '' %>">
        [01] CONSOLA SOC (48 EPISODIOS)
      </a>
      <a href="/simulators" class="soc-btn <%= request.path_info.start_with?('/simulators') ? 'active' : '' %>">
        [02] SIMULADORES BLADES MRI &amp; NANOMED EDR
      </a>
      <a href="/reports/postmortem-full-48.md" class="soc-btn soc-btn-warning">
        [03] DESCARGAR POST-MORTEM 48 EP (.MD)
      </a>
      <a href="/bibliografia" class="soc-btn nav-btn-bibliography <%= request.path_info.start_with?('/bibliografia') || request.path_info.start_with?('/bibliography') ? 'active' : '' %>">
        [★] BIBLIOGRAFÍA
      </a>
      <a href="/muro" class="soc-btn nav-btn-feed <%= request.path_info.start_with?('/muro') || request.path_info.start_with?('/feed') ? 'active' : '' %>" style="border-color: var(--bauble-cyan-bright); color: var(--bauble-cyan-bright);">
        [💬] MURO SOCIAL CLÍNICO
      </a>
      <a href="/mobile" class="soc-btn nav-btn-mobile" style="border-color: var(--magic-ring); color: var(--magic-highlight);" title="Versión móvil optimizada exclusiva para el feed">
        [📱] MÓVIL
      </a>
      <button type="button" id="btn-share-topbar-wa" class="soc-btn soc-btn-wa" title="Compartir consola y telemetría en WhatsApp">
        <span class="share-wa-icon" aria-hidden="true">💬</span> COMPARTIR WA
      </button>
    </nav>
  </header>

  <!-- FRANJA DE SIGNOS VITALES ECG (#00F200) Y 6 INDICADORES AZULES DE INTEGRIDAD (EP04 SKEET SHOOT) -->
  <section class="vitals-ribbon" aria-label="Telemetría de Signos Vitales y Nodos Críticos">
    <div class="ecg-monitor-box">
      <div>
        <div style="font-size: 0.7rem; color: var(--hud-glass-outline);">ZAK // CYBERIA ECG</div>
        <div id="live-bpm-readout" style="font-size: 0.95rem; font-weight: 700; color: var(--magic-pulse-core);">
          72 BPM [SYNC 100%]
        </div>
      </div>
      <canvas id="blades-ecg-canvas" class="ecg-canvas" width="165" height="38"></canvas>
    </div>

    <div class="nodes-six-grid" id="six-hull-nodes">
      <% (@nodes || TelemetryNode.all).each do |node| %>
        <div class="hull-node-pill" title="<%= node[:game_ref] %> — Protocol: <%= node[:protocol] %>">
          <div class="node-id">
            <span><%= node[:id] %></span>
            <span style="color: var(--magic-main);"><%= node[:integrity] %>%</span>
          </div>
          <div class="node-name"><%= node[:name] %></div>
        </div>
      <% end %>
    </div>
  </section>

  <!-- OVERLAY LANDING PAGE: GUÍA CLÍNICA Y TUTORIAL KALI LINUX (SOBREPUESTA CON TRANSPARENCIA SOBRE NEGRO) -->
  <%= erb :_tutorial_overlay, layout: false %>

  <%= yield %>

  <!-- MODAL HUB PARA COMPARTIR EN WHATSAPP -->
  <div id="cyberia-wa-modal" class="cyberia-modal-overlay" style="display: none;" aria-hidden="true" role="dialog" aria-label="Compartir en WhatsApp">
    <div class="cyberia-modal-content">
      <div class="cyberia-modal-header">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-size: 1.1rem;" aria-hidden="true">💬</span>
          <strong style="color: #25D366; letter-spacing: 0.5px;">COMPARTIR EN WHATSAPP // CYBERIA HUB</strong>
        </div>
        <button type="button" class="cyberia-modal-close" aria-label="Cerrar ventana">&times;</button>
      </div>
      <div class="cyberia-modal-body">
        <p style="font-size: 0.78rem; color: var(--hud-glass-outline); margin-top: 0; margin-bottom: 0.85rem;">
          Selecciona la sección del Pod Clínico que deseas transmitir directamente a tus contactos o grupos de WhatsApp:
        </p>
        <div class="wa-share-grid">
          <button type="button" class="wa-share-card-btn" data-share-target="console">
            <div class="wa-share-card-icon">🌐</div>
            <div class="wa-share-card-info">
              <div class="wa-share-card-title">CONSOLA SOC PRINCIPAL</div>
              <div class="wa-share-card-desc">Plataforma central interactiva y los 48 episodios clínicos</div>
            </div>
            <div class="wa-share-card-arrow">↗</div>
          </button>

          <button type="button" class="wa-share-card-btn" data-share-target="episode">
            <div class="wa-share-card-icon">🎧</div>
            <div class="wa-share-card-info">
              <div class="wa-share-card-title">EPISODIO EN CURSO</div>
              <div class="wa-share-card-desc">Telemetría, vulnerabilidad CVE y los 4 pilares del episodio activo</div>
            </div>
            <div class="wa-share-card-arrow">↗</div>
          </button>

          <button type="button" class="wa-share-card-btn" data-share-target="feed">
            <div class="wa-share-card-icon">📡</div>
            <div class="wa-share-card-info">
              <div class="wa-share-card-title">MURO SOCIAL CLÍNICO</div>
              <div class="wa-share-card-desc">Transmisión P2P en tiempo real de comentarios, hallazgos y debates</div>
            </div>
            <div class="wa-share-card-arrow">↗</div>
          </button>

          <button type="button" class="wa-share-card-btn" data-share-target="sentinel">
            <div class="wa-share-card-icon">🛡️</div>
            <div class="wa-share-card-info">
              <div class="wa-share-card-title">SENTINEL AEGIS-9</div>
              <div class="wa-share-card-desc">Misión táctica de mitigación, defensa hospitalaria y killchain</div>
            </div>
            <div class="wa-share-card-arrow">↗</div>
          </button>

          <button type="button" class="wa-share-card-btn" data-share-target="tutorial">
            <div class="wa-share-card-icon">⚡</div>
            <div class="wa-share-card-info">
              <div class="wa-share-card-title">METODOLOGÍA 48 PASOS</div>
              <div class="wa-share-card-desc">Guía clínica, seguridad de transformadores LIM y simuladores</div>
            </div>
            <div class="wa-share-card-arrow">↗</div>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/sentinel_tactical_game.js"></script>
  <script src="/js/cyberia_console.js"></script>
  <script src="/js/clinical_feed.js"></script>
</body>
</html>
